#!/usr/bin/env bash
# Software factory CLI: harness, job state, removal audit, dashboard, Codex install.
# Code lives in this plugin; state lives in the project you run it from.
# python -P keeps the current directory off sys.path, so a project's own factory/
# package can never shadow the plugin's.
set -euo pipefail

PLUGIN="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="${FACTORY_VENV:-$HOME/.factory/venv}"
export PYTHONPATH="$PLUGIN${PYTHONPATH:+:$PYTHONPATH}"

# The CLI and tests need Python 3.11+ (python -P, tomllib). A machine's default python3 can be
# older, so pick the first interpreter that qualifies; FACTORY_PYTHON overrides.
pick_python() {
  local candidate
  for candidate in "${FACTORY_PYTHON:-}" python3.13 python3.12 python3.11 python3; do
    [ -n "$candidate" ] || continue
    command -v "$candidate" >/dev/null 2>&1 || continue
    if "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
      echo "$candidate"
      return 0
    fi
  done
  echo "factory needs Python 3.11 or later; install one or set FACTORY_PYTHON." >&2
  return 1
}

usage() {
  cat <<'USAGE'
usage: factory <command> [args]

  init                      give this project a .factory/profile.md and gitignore entries
  run "<task, verbatim>"    run the full graph on the Claude Agent SDK (needs setup)
  resume <job> | status <job>
  state <args>              job state helper (new, list, show, bind, stage, round, check, ready, delivered)
  guard <job> --head <sha>  removal audit
  serve [--port 8765]       local dashboard of saved jobs (loopback only)
  codex install <project>   generate Codex skills, agents and hook for a project
  onboard [--write|--check] refresh the AGENTS.md workflow block and the profile it holds
  setup                     one-time: install claude-agent-sdk into $FACTORY_VENV (default ~/.factory/venv)
  test                      run the plugin's offline test suites
USAGE
}

command="${1:-help}"
case "$command" in help|-h|--help) ;; *) PY="$(pick_python)" ;; esac
[ $# -gt 0 ] && shift

case "$command" in
  setup)
    "$PY" -m venv "$VENV"
    "$VENV/bin/pip" install -q -r "$PLUGIN/factory/requirements.txt"
    echo "harness ready: $VENV"
    ;;
  run|resume)
    if [ ! -x "$VENV/bin/python" ]; then
      echo "claude-agent-sdk is not installed. Run: $PLUGIN/bin/factory setup" >&2
      exit 1
    fi
    exec "$VENV/bin/python" -P -m factory.harness "$command" "$@"
    ;;
  status|init) exec "$PY" -P -m factory.harness "$command" "$@" ;;
  state)  exec "$PY" "$PLUGIN/factory/scripts/state.py" "$@" ;;
  guard)  exec "$PY" "$PLUGIN/factory/scripts/guard.py" "$@" ;;
  serve)  exec "$PY" "$PLUGIN/factory/scripts/serve.py" "$@" ;;
  codex)  exec "$PY" "$PLUGIN/factory/codex.py" "$@" ;;
  onboard) exec "$PY" -P "$PLUGIN/factory/onboard.py" "$@" ;;
  test)
    status=0
    for suite in "$PLUGIN"/tests/test_*.py; do
      echo "== $(basename "$suite")"
      "$PY" "$suite" || status=1
    done
    exit $status
    ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
